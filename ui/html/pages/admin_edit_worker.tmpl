{{define "title"}}Edit Worker{{end}}

{{define "main"}}
{{template "nav" .}}

{{if .Flash}}<p class="flash">{{.Flash}}</p>{{end}}

<h1>Edit worker</h1>
<form action="/admin/workers/{{.Worker.ID}}/edit" method="POST">
    <label for="worker_name">Name</label>
    <input type="text" id="worker_name" name="worker_name" value="{{.Worker.WorkerName}}" required>

    <label for="pin">PIN</label>
    <input type="text" inputmode="numeric" id="pin" name="pin" value="{{.Worker.PIN}}" required>

    <label for="phone">Phone</label>
    <input type="tel" id="phone" name="phone" value="{{.Worker.Phone}}">

    <label for="hourly_rate">Hourly Rate ($)</label>
    <input type="number" id="hourly_rate" name="hourly_rate" min="0" step="0.01" value="{{if .Worker.HourlyRate}}{{printf "%.2f" .Worker.HourlyRate}}{{end}}">

    <label for="language">Language</label>
    <select id="language" name="language">
        <option value="spanish"{{if ne .Worker.Language "english"}} selected{{end}}>Spanish</option>
        <option value="english"{{if eq .Worker.Language "english"}} selected{{end}}>English</option>
    </select>

    <button type="submit">Save</button>
</form>
{{end}}
