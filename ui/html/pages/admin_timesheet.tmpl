{{define "title"}}Timesheet{{end}}

{{define "main"}}
{{template "nav" .}}

<h1>Timesheet</h1>
<p>Pay period:
<select onchange="window.location='/admin/timesheet?period='+this.value">
{{range .PayPeriods}}<option value="{{.}}"{{if eq . $.CurrentPeriod}} selected{{end}}>{{.}}</option>
{{end}}
</select>
</p>
<p><a href="/admin/punches/new">+ Add entry</a></p>

<table>
<tr>
    <th>Worker</th><th>Day</th><th>In</th><th>Out</th><th>Late</th><th>Edited</th><th>Non-compliant</th><th>Location</th><th></th>
</tr>
{{range .TimesheetRows}}
<tr{{if and .NonCompliant (not .ModifiedByAdmin)}} class="non-compliant"{{else if .NonCompliant}} class="nc-edited"{{else if .Late}} class="late"{{end}}>
    <td>{{.WorkerName}}</td>
    <td>{{.Day}}</td>
    <td>{{.StartTime.Local.Format "3:04 PM"}}</td>
    <td>{{.EndTimeDisplay}}</td>
    <td>{{if .Late}}yes{{end}}</td>
    <td>{{if .ModifiedByAdmin}}yes{{end}}</td>
    <td>{{if .NonCompliant}}yes{{end}}</td>
    <td>
        {{if .StartLat.Valid}}<a href="{{printf "https://www.google.com/maps?q=%v,%v" .StartLat.Float64 .StartLon.Float64}}" target="_blank">in</a>{{else}}in{{end}}
        {{if .EndLat.Valid}} / <a href="{{printf "https://www.google.com/maps?q=%v,%v" .EndLat.Float64 .EndLon.Float64}}" target="_blank">out</a>{{end}}
    </td>
    <td>
        <a href="/admin/punches/{{.ID}}/edit">edit</a>
        <form method="POST" action="/admin/punches/{{.ID}}/delete" style="display:inline">
            <button type="submit" class="btn-delete" onclick="return confirm('Delete this entry?')">delete</button>
        </form>
    </td>
</tr>
{{end}}
</table>
{{end}}
