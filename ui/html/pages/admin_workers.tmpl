{{define "title"}}Workers{{end}}

{{define "main"}}
{{template "nav" .}}

{{if .Flash}}<p class="flash">{{.Flash}}</p>{{end}}

<h1>Workers</h1>
{{if .ShowInactiveWorkers}}
<p><a href="/admin/workers">Hide deactivated workers</a></p>
{{else}}
<p><a href="/admin/workers?show_inactive=1">Show deactivated workers</a></p>
{{end}}
<table>
<tr><th>Name</th><th>PIN</th><th>Phone</th><th>Hourly Rate</th><th>Language</th><th>Active</th><th></th></tr>
{{range .Workers}}
<tr>
    <td>{{.WorkerName}}</td>
    <td>{{.PIN}}</td>
    <td>{{.Phone}}</td>
    <td>{{if .HourlyRate}}${{printf "%.2f" .HourlyRate}}{{else}}-{{end}}</td>
    <td>{{if eq .Language "english"}}English{{else}}Spanish{{end}}</td>
    <td>{{if .Active}}yes{{else}}no{{end}}</td>
    <td>
        <a href="/admin/workers/{{.ID}}/edit">Edit</a>
        <form action="/admin/workers/{{.ID}}/toggle-active" method="POST" class="inline">
            <button type="submit">{{if .Active}}Deactivate{{else}}Reactivate{{end}}</button>
        </form>
    </td>
</tr>
{{end}}
</table>

<h2>Add worker</h2>
<form action="/admin/workers" method="POST">
    <label for="worker_name">Name</label>
    <input type="text" id="worker_name" name="worker_name" required>

    <label for="pin">PIN</label>
    <input type="password" inputmode="numeric" id="pin" name="pin" required>

    <label for="phone">Phone</label>
    <input type="tel" id="phone" name="phone">

    <label for="hourly_rate">Hourly Rate ($)</label>
    <input type="number" id="hourly_rate" name="hourly_rate" min="0" step="0.01" placeholder="0.00">

    <label for="language">Language</label>
    <select id="language" name="language">
        <option value="spanish" selected>Spanish</option>
        <option value="english">English</option>
    </select>

    <label>
        <input type="checkbox" name="require_location"> Require location to punch in
    </label>

    <button type="submit">Add</button>
</form>
{{end}}
